# Copie para .env e preencha. NUNCA versione o .env de verdade (só este exemplo).

# Porta do servidor (em produção o Render injeta a dele; local usa 3333).
PORT=3333

# String de conexão do MongoDB Atlas.
MONGODB_URI=mongodb+srv://<user>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Segredo para assinar/verificar o JWT (use algo longo e aleatório).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token (ex.: 7d, 12h).
JWT_EXPIRES_IN=7d

# Credencial do Cloudinary (formato: cloudinary://<api_key>:<api_secret>@<cloud_name>).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Origens permitidas no CORS (front). Separe por vírgula. Se vazio, libera geral (só dev).
# Em produção, defina a URL do front no Vercel, ex.:
# CORS_ORIGIN=https://seu-front.vercel.app,http://localhost:5173
CORS_ORIGIN=
